@PACKAGE_INIT@

include(CMakeFindDependencyMacro)

if("@QT_VERSION_MAJOR@" STREQUAL "5")
    find_dependency(Qt5 5.11 REQUIRED COMPONENTS Core Gui Widgets PrintSupport Svg)
else()
    find_dependency(Qt6 REQUIRED COMPONENTS Core Gui Widgets PrintSupport Svg)
endif()

if("@CMAKE_SYSTEM_NAME@" STREQUAL "Linux")
    find_dependency(Qt5 REQUIRED COMPONENTS X11Extras)
    find_dependency(X11 REQUIRED)
endif()

include("${CMAKE_CURRENT_LIST_DIR}/BaseWidgetsTargets.cmake")

set_and_check(BaseWidgets_ASSETS_DIR "${PACKAGE_PREFIX_DIR}/assets")
set_and_check(BaseWidgets_INCLUDE_DIR "${PACKAGE_PREFIX_DIR}/interface")
