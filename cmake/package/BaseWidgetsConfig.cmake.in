@PACKAGE_INIT@

include(CMakeFindDependencyMacro)

find_dependency(Qt@QT_VERSION_MAJOR@ REQUIRED COMPONENTS Core Gui Widgets PrintSupport Svg)

if(UNIX AND NOT APPLE)
    find_dependency(Qt@QT_VERSION_MAJOR@ REQUIRED COMPONENTS X11Extras)
endif()

include("${CMAKE_CURRENT_LIST_DIR}/BaseWidgetsTargets.cmake")

set_and_check(BaseWidgets_ASSETS_DIR "${PACKAGE_PREFIX_DIR}/assets")
set_and_check(BaseWidgets_INCLUDE_DIR "${PACKAGE_PREFIX_DIR}/interface")
