/*  ------------------------------------------------------------------------  */
/* QtMaterial - https://github.com/UN-GCPDS/qt-material
/* By Yeison Cardona - GCPDS
/*  ------------------------------------------------------------------------  */

*{
  color: {{regularTextColor}};
  font-family: {{font_family}};
  line-height: {{line_height}};
  font-size: {{font_size}};
  selection-background-color: {{primaryColor}};
  selection-color: {{secondaryTextColor}};
}

*:focus {
   outline: none;
}

/*  ------------------------------------------------------------------------  */
/*  Custom colors  */

.danger{
  color: {{danger}};
}

.warning{
  color: {{warning}};
}

.success{
  color: {{success}};
}

/*  ------------------------------------------------------------------------  */
/*  Basic widgets  */
QMainWindow {
  background-color: {{baseBackgroundColor}};
}

QMainWindow::separator:vertical,
QSplitter::handle:horizontal {
  image: url(icon:/primary/splitter-horizontal.svg);
}

QMainWindow::separator:horizontal,
QSplitter::handle:vertical {
  image: url(icon:/primary/splitter-vertical.svg);
}

QSplitter {
  background-color: transparent;
  border: none
}

QWidget {
  background-color: {{pageBackgroundColor}};
  color: {{primaryTextColor}};
  font-size: 13px;
}

QWidget:disabled {
  color: {{disabledTextColor}};
}

/*标题栏*/
QWidget[title='true'] {
  background-color: qlineargradient(x1:0 y1:0 x2:0 y2:1,
  stop:0 {{darkFillColor}},
  stop:1 {{baseBackgroundColor}});
  border-bottom: 1px solid {{darkerBorderColor}};
}

QDialog {
  background-color: {{baseBackgroundColor}};
  border: 1px solid {{darkerBorderColor}};
  border-radius: 4px;
}

/*弹窗主内容*/
QWidget[msgContainer='true'],
QWidget[msgContent='true'] {
  background-color: transparent;
}

QDialog QToolButton,
QDialog QToolButton:hover,
QDialog QToolButton:pressed,
QDialog QToolButton:checked {
  background: transparent;
  background-color: transparent;
  border: 0px;
  height: auto;
  margin: 0px;
  padding: 0px;
  border-right: 0px;
  border-left: 0px;
}

QFrame {
  background-color: {{baseFillColor}};
  border: 1px solid {{darkerBorderColor}};
  border-radius: 4px;
}

QFrame[frameShape="0"] {  /* NoFrame */
    border: none;
    background-color: transparent;
}

QFrame[frameShape="1"],    /*  Box  */
QFrame[frameShape="2"] {   /* Panel */
    border: 1px solid {{darkBorderColor}};
    background-color: {{baseFillColor}};
}

QFrame[frameShape="3"] {   /* WinPanel */
    border: 1px outset {{darkBorderColor}};
    background-color: {{baseFillColor}};
}

QFrame[frameShape="4"] {   /* HLine */
    max-height: 1px;
    border: none;
    background-color: {{darkBorderColor}};
}

QFrame[frameShape="4"] {   /* VLine */
    max-width: 1px;
    border: none;
    background-color: {{darkBorderColor}};
}

QScrollArea,
QStackedWidget,
QWidget > QToolBox,
QToolBox > QWidget,
QTabWidget > QWidget {
  border: none;
}

QTabWidget::pane {
  border: none;
  color: {{pageBackgroundColor}};
  margin-top: -1px;
}

/*  ------------------------------------------------------------------------  */
/*  QMenu  */

QMenu {
  background-color: {{overlayBackgroundColor}};
  border: 1px solid {{darkerBorderColor}};
  border-radius: 2px;
  color: {{primaryTextColor}};
  padding: 2px 0px;
}

QMenu::separator {
  height: 1px;
  background-color: {{darkerBorderColor}};
  margin: 4px 8px;
}

QMenu::right-arrow{
  image: url(icon:/primary/rightarrow.svg);
  width: 15px;
  height: 15px;
}

QMenu::right-arrow:selected{
  image: url(icon:/primary/rightarrow.svg);
}

QMenu::indicator:non-exclusive:unchecked {
  image: url(icon:/primary/check_box_unchecked.svg);
}

QMenu::indicator:non-exclusive:unchecked:selected {
  image: url(icon:/primary/check_box_unchecked.svg);
}

QMenu::indicator:non-exclusive:checked {
  image: url(icon:/primary/check_box_checked.svg);
}

QMenu::indicator:non-exclusive:checked:selected {
  image: url(icon:/primary/check_box_checked.svg);
}

QMenu::indicator:exclusive:unchecked {
  image: url(icon:/primary/radiobutton_unchecked.svg);
}

QMenu::indicator:exclusive:unchecked:selected {
  image: url(icon:/primary/radiobutton_unchecked.svg);
}

QMenu::indicator:exclusive:checked {
  image: url(icon:/primary/radiobutton_checked.svg);
}

QMenu::indicator:exclusive:checked:selected {
  image: url(icon:/primary/radiobutton_checked.svg);
}

/*  ------------------------------------------------------------------------  */
/*  QMenuBar  */

QMenuBar {
  background-color: {{baseBackgroundColor}};
  border-bottom: 1px solid {{darkerBorderColor}};
  color: {{primaryTextColor}};
  padding: 6px 0px;
}

QMenuBar::item {
  background: transparent;
  padding: 8px 16px;
  margin: 0 2px;
}

QMenuBar::item:selected {
  color: {{primaryTextColor}};
  background-color: {{baseFillColor}};
}

QMenuBar::item:pressed {
  background-color: {{darkFillColor}};
}

/*  ------------------------------------------------------------------------  */
/*  QPushButton  */

QPushButton {
  background-color: {{darkerFillColor}};
  color: {{primaryTextColor}};
  border: 1px solid {{darkerBorderColor}};
  border-radius: 4px;
  padding: 8px 16px;
  min-width: 60px;
  min-height: 22px;
  font-size: 13px;
  font-weight: 500;
  outline: none;
}

QPushButton:hover {
  background-color: {{primaryColor|opacity(0.6)}};
}

QPushButton:checked {
  background-color: {{primaryColor}};
  border-color: {{primaryColor}};
}

QPushButton:pressed {
  border-color: {{primaryColor|opacity(0.8)}};
}

/*主按钮*/
QPushButton[primary='true'] {
  color: {{primaryTextColor}};
  background-color: {{primaryColor}};
  border-color: {{primaryColor}};
}

QPushButton[primary='true']:hover {
  background-color: {{primaryColor|opacity(0.8)}};
}

QPushButton:flat {
  padding: 5px;
  margin: 0px;
  color: {{regularTextColor}};
  border: none;
  background-color: transparent;
}

QPushButton:flat:hover {
  background-color: {{darkerFillColor|opacity(0.2)}};
}

QPushButton:flat:pressed,
QPushButton:flat:checked {
  background-color: {{darkerFillColor|opacity(0.1)}};
}

QPushButton:disabled,
QPushButton:flat:disabled {
  color: {{disabledTextColor|opacity(0.75)}};
  background-color: transparent;
  border-color:  {{lightBorderColor}};
}

QPushButton:disabled {
  border: 1px solid {{placeholderTextColor}};
}

QPushButton:checked:disabled {
  color: {{disabledTextColor}};
  background-color: {{darkerFillColor}};
  border-color:  {{lightBorderColor}};
}

/*  ------------------------------------------------------------------------  */
/*  QLabel  */

QLabel {
  border: none;
  background: transparent;
  color: {{regularTextColor}}
}

QLabel[title='true'] {
  color: {{primaryTextColor}};
  font-size: 14px;
  font-weight: 600;
  padding: 8px 12px;
}

QLabel:disabled {
  color: {{disabledTextColor|opacity(0.2)}}
}

/*  ------------------------------------------------------------------------  */
/*  QTabBar  */

QTabBar{
  font-weight: bold;
}

QTabBar::tab {
  background-color: transparent;
  color: {{secondaryTextColor}};
  padding: 10px 20px;
  font-weight: bold;
  border: none;
  margin-right: 2px;
}

QTabBar::tab:selected {
  color: {{primaryColor}};
  border-bottom: 1px solid {{primaryColor}};
}

QTabBar::tab:hover:!selected {
  color: {{primaryColor}};
}

QTabBar::close-button {
  image: url(icon:/disabled/tab_close.svg);
}

QTabBar::close-button:hover {
  image: url(icon:/primary/tab_close.svg);
}

/*  ------------------------------------------------------------------------  */
/*  QStatusBar  */

QStatusBar {
  color: {{primaryTextColor}};
  background-color: qlineargradient(x1:0 y1:0 x2:0 y2:1,
    stop:0 {{baseBackgroundColor}},
    stop:1 {{darkFillColor}});
  border-top: 1px solid {{darkerBorderColor}};
  color: {{secondaryTextColor}};
  font-size: 13px;
  padding: 6px 12px;
}

QStatusBar::item {
  border: none;
}

/*  ------------------------------------------------------------------------  */
/*  Inputs  */

QDateEdit,
QTimeEdit,
QDateTimeEdit,
QSpinBox,
QDoubleSpinBox {
  color: {{primaryTextColor}};
  background-color: {{overlayBackgroundColor}};
  border: 1px solid {{darkerBorderColor}};
  selection-background-color: {{primaryColor}};
  selection-color: {{primaryTextColor}};
  border: 1px solid {{darkerBorderColor}};
  border-radius: 2px;
  padding: 8px 16px ;
  height: 18px;
}

QDateEdit,
QTimeEdit,
QDateTimeEdit,
QSpinBox,
QDoubleSpinBox {
  padding-left: 15px;
  border-radius: 0px;
  background-color: {{overlayBackgroundColor}};
  border-width: 0 0 2px 0;
  border-radius: 0px;
  border-top-left-radius: 4px;
  border-top-right-radius: 4px;
}

QLineEdit,
QTextEdit,
QPlainTextEdit {
  border-radius: 2px;
  padding: 8px 12px;
  font-size: 13px;
  background-color: {{overlayBackgroundColor}};
  selection-color: {{primaryTextColor}};
  selection-background-color: {{primaryColor}};
  border: 1px solid {{darkerBorderColor}};
}

QLineEdit:focus,
QTextEdit:focus,
QPlainTextEdit:focus {
  background-color: {{darkFillColor}};
  border: 1px solid {{primaryColor}};
}

QDateTimeEdit:disabled,
QSpinBox:disabled,
QDoubleSpinBox:disabled,
QTextEdit:disabled,
QLineEdit:disabled {
  color: {{disabledTextColor|opacity(0.2)}};
  background-color: {{baseBackgroundColor|opacity(0.75)}};
  border-width: 0 0 2px 0;
  padding: 8px 16px ;
  border-radius: 0px;
  border-top-left-radius: 4px;
  border-top-right-radius: 4px;
}

QDateTimeEdit:disabled,
QSpinBox:disabled,
QDoubleSpinBox:disabled,
QTextEdit:disabled,
QLineEdit:disabled {
  color: {{disabledTextColor|opacity(0.2)}};
  background-color: {{darkerFillColor|opacity(0.75)}};
  border: 1px solid {{darkBorderColor|opacity(0.2)}};
  border-width: 0 0 2px 0;
}

/*  ------------------------------------------------------------------------  */
/*  QComboBox  */

QComboBox {
  color: {{primaryTextColor}};
  border: 1px solid {{darkerBorderColor}};
  background-color: {{overlayBackgroundColor}};
  border-radius: 2px;
  padding: 8px 12px;
  min-width: 80px;
}

QComboBox::item {
  height: 26px;
  border: 1px solid transparent;
  color: {{primaryTextColor}};
}

QComboBox::item:selected {
color: {{primaryTextColor}};
  background-color: {{primaryColor}};
  border-radius: 2px;
}

QComboBox::item:disabled {
  color: {{placeholderTextColor}};
}

QComboBox:disabled {
  color: {{disabledTextColor|opacity(0.2)}};
  background-color: {{secondaryColor|opacity(0.75)}};
  border-bottom: 2px solid {{primaryColor|opacity(0.2)}};
}

QComboBox::drop-down {
  border: none;
  width: 20px;
}

QComboBox::down-arrow {
  image: url(icon:/primary/downarrow.svg);
  border-left: 4px solid transparent;
  border-right: 4px solid transparent;
  border-top: 4px solid transparent;
  margin-right: 10px;
}

QComboBox::down-arrow:disabled {
  image: url(icon:/disabled/downarrow.svg);
  margin-right: 10px;
}

QComboBox QAbstractItemView {
  background-color: {{overlayBackgroundColor}};
  border: 1px solid {{darkerBorderColor}};
  color: {{primaryTextColor}};
  selection-background-color: {{primaryColor}};
  outline: none;
}

QComboBox[frame='false'] {
  color: {{regularTextColor}};
  background-color: transparent;
  border: 1px solid transparent;
}
QComboBox[frame='false']:disabled {
  color: {{disabledTextColor|opacity(0.2)}};
}

/*  ------------------------------------------------------------------------  */
/*  Spin buttons  */

QTimeEdit::up-button,
QDoubleSpinBox::up-button,
QSpinBox::up-button {
  width: 20px; /* 16 + 2*1px border-width = 15px padding + 3px parent border */
  image: url(icon:/primary/uparrow.svg);
  border-width: 0px;
  margin-right: 5px;
}

QTimeEdit::up-button:disabled,
QDoubleSpinBox::up-button:disabled,
QSpinBox::up-button:disabled {
  image: url(icon:/disabled/uparrow.svg);
}

QTimeEdit::down-button,
QDateTimeEdit::drop-down,
QDateEdit::drop-down,
QDoubleSpinBox::down-button,
QSpinBox::down-button {
  width: 20px;
  image: url(icon:/primary/downarrow.svg);
  border-width: 0px;
  border-top-width: 0;
  margin-right: 5px;
}

QTimeEdit::down-button:disabled,
QDateTimeEdit::drop-down:disabled,
QDateEdit::drop-down:disabled,
QDoubleSpinBox::down-button:disabled,
QSpinBox::down-button:disabled {
  image: url(icon:/disabled/downarrow.svg);
}

/*  ------------------------------------------------------------------------  */
/*  QGroupBox  */

QGroupBox {
  background-color: {{overlayBackgroundColor}};
  border-radius: 4px;
  border: 1px solid {{darkerBorderColor}};
  margin-top: 13px;
  font-weight: bold;
  padding-top: 8px;
}

QGroupBox::title {
  color: {{primaryTextColor}};
  subcontrol-origin: margin;
  subcontrol-position: top left;
  padding: 0 8px;
  border: none;
  background-color: transparent;
}

/*  ------------------------------------------------------------------------  */
/*  QRadioButton and QCheckBox labels  */

QRadioButton,
QCheckBox {
  color: {{primaryTextColor}};
  line-height: 14px;
  height: 30px;
  background-color: transparent;
  spacing: 8px;
}

QRadioButton:disabled,
QCheckBox:disabled {
  color: {{disabledTextColor|opacity(0.3)}};
}


/*  ------------------------------------------------------------------------  */
/*  QTableView  */

QTableView,
QTableWidget {
  color: {{primaryTextColor}};
  gridline-color: {{darkerBorderColor}};
  border: 1px solid {{darkerBorderColor}};
  border-radius: 2px;
  outline: none;
  background-color: {{overlayBackgroundColor}};
  alternate-background-color: {{darkFillColor}};
}

/* 统一表头空白区背景，避免未填充区域出现黑块 */
QTableCornerButton::section {
  background-color: {{baseBackgroundColor}};
  border-radius: 0px;
  border-right: 1px solid;
  border-bottom: 1px solid;
  border-color: {{darkerBorderColor}};
}

QHeaderView::section {
  color: {{secondaryTextColor}};
  background-color: {{baseBackgroundColor}};
  padding: 8px;
  border: none;
  border-right: 1px solid {{darkerBorderColor}};
  font-weight: 600;
}

/*  ------------------------------------------------------------------------  */
/*  QTreeView  */

QTreeView,
QListView {
  padding-left: 15px;
  background-color: {{overlayBackgroundColor}};
  color: {{primaryTextColor}};
  border: 1px solid {{darkerBorderColor}};
  border-radius: 2px;
  outline: none;
}

QTreeView::branch{
  background: transparent;
  border-image: none;
}

QTreeView::branch:closed:has-children {
  image: url(icon:/primary/rightarrow.svg);
}

QTreeView::branch:open:has-children {
  image: url(icon:/primary/downarrow.svg);
}

/*  ------------------------------------------------------------------------  */
/*  General Indicators  */

QGroupBox::indicator {
  width: 18px;
  height: 18px;
  border-radius: 2px;
}

QMenu::indicator,
QListView::indicator,
QTableWidget::indicator,
QRadioButton::indicator,
QCheckBox::indicator {
  width: 24px;
  height: 24px;
  border-radius: 2px;
}

/*  ------------------------------------------------------------------------  */
/*  QListView Indicator  */

QListView::indicator:checked,
QListView::indicator:checked:selected,
QListView::indicator:checked:focus {
  image: url(icon:/primary/checklist.svg);
}

QListView::indicator:checked:selected:active {
  image: url(icon:/primary/checklist_invert.svg);
}

QListView::indicator:checked:disabled {
  image: url(icon:/disabled/checklist.svg);
}

QListView::indicator:indeterminate,
QListView::indicator:indeterminate:selected,
QListView::indicator:indeterminate:focus {
  image: url(icon:/primary/checklist_indeterminate.svg);
}

QListView::indicator:indeterminate:selected:active {
  image: url(icon:/primary/checklist_indeterminate_invert.svg);
}

QListView::indicator:indeterminate:disabled {
  image: url(icon:/disabled/checklist_indeterminate.svg);
}

/*  ------------------------------------------------------------------------  */
/*  QTableView Indicator  */

QTableView::indicator:enabled:checked,
QTableView::indicator:enabled:checked:selected,
QTableView::indicator:enabled:checked:focus {
  image: url(icon:/primary/check_box_checked.svg);
}

QTableView::indicator:checked:selected:active {
  image: url(icon:/primary/check_box_checked_invert.svg);
}

QTableView::indicator:disabled:checked,
QTableView::indicator:disabled:checked:selected,
QTableView::indicator:disabled:checked:focus {
  image: url(icon:/disabled/check_box_checked.svg);
}

QTableView::indicator:enabled:unchecked,
QTableView::indicator:enabled:unchecked:selected,
QTableView::indicator:enabled:unchecked:focus {
  image: url(icon:/primary/check_box_unchecked.svg);
}

QTableView::indicator:unchecked:selected:active {
  image: url(icon:/primary/check_box_unchecked_invert.svg);
}

QTableView::indicator:disabled:unchecked,
QTableView::indicator:disabled:unchecked:selected,
QTableView::indicator:disabled:unchecked:focus {
  image: url(icon:/disabled/check_box_unchecked.svg);
}

QTableView::indicator:enabled:indeterminate,
QTableView::indicator:enabled:indeterminate:selected,
QTableView::indicator:enabled:indeterminate:focus {
  image: url(icon:/primary/checkbox_indeterminate.svg);
}

QTableView::indicator:indeterminate:selected:active {
  image: url(icon:/primary/checkbox_indeterminate_invert.svg);
}

QTableView::indicator:disabled:indeterminate,
QTableView::indicator:disabled:indeterminate:selected,
QTableView::indicator:disabled:indeterminate:focus {
  image: url(icon:/disabled/checkbox_indeterminate.svg);
}

/*  ------------------------------------------------------------------------  */
/*  QCheckBox and QGroupBox Indicator  */

QCheckBox::indicator:checked,
QGroupBox::indicator:checked {
  image: url(icon:/primary/check_box_checked.svg);
}

QCheckBox::indicator:unchecked,
QGroupBox::indicator:unchecked {
  image: url(icon:/primary/check_box_unchecked.svg);
}

QCheckBox::indicator:indeterminate,
QGroupBox::indicator:indeterminate {
  image: url(icon:/primary/checkbox_indeterminate.svg);
}

QCheckBox::indicator:checked:disabled,
QGroupBox::indicator:checked:disabled {
  image: url(icon:/disabled/check_box_checked.svg);
}

QCheckBox::indicator:unchecked:disabled,
QGroupBox::indicator:unchecked:disabled {
  image: url(icon:/disabled/check_box_unchecked.svg);
}

QCheckBox::indicator:indeterminate:disabled,
QGroupBox::indicator:indeterminate:disabled {
  image: url(icon:/disabled/checkbox_indeterminate.svg);
}

/*  ------------------------------------------------------------------------  */
/*  QRadioButton Indicator  */

QRadioButton::indicator:checked {
  image: url(icon:/primary/radiobutton_checked.svg);
}

QRadioButton::indicator:unchecked {
  image: url(icon:/primary/radiobutton_unchecked.svg);
}

QRadioButton::indicator:checked:disabled {
  image: url(icon:/disabled/radiobutton_checked.svg);
}

QRadioButton::indicator:unchecked:disabled {
  image: url(icon:/disabled/radiobutton_unchecked.svg);
}

/*  ------------------------------------------------------------------------  */
/*  QDockWidget  */

QDockWidget {
  color: {{secondaryTextColor}};
  text-transform: uppercase;
  border: 2px solid {{darkBorderColor}};
  titlebar-close-icon: url(icon:/primary/close.svg);
  titlebar-normal-icon: url(icon:/primary/float.svg);
  border-radius: 2px;
}

QDockWidget::title {
  text-align: left;
  padding-left: 35px;
  padding: 3px;
  margin-top: 4px;
}

/*  ------------------------------------------------------------------------  */
/*  QComboBox indicator  */

QComboBox::indicator:checked {
  image: url(icon:/primary/checklist_invert.svg);
}

QComboBox::indicator:checked:selected {
  image: url(icon:/primary/checklist.svg);
}

/*  ------------------------------------------------------------------------  */
/*  Menu Items  */

QMenu::item {
  padding: 8px 16px 8px 16px;
  background-color: transparent;
  color: {{primaryTextColor}};
}

QMenu::item:selected {
  background-color: {{primaryColor|opacity(0.6)}};
  border: 1px solid {{lightBorderColor}};
}

QMenu::item:disabled {
  color: {{disabledTextColor|opacity(0.3)}};
}

/*  ------------------------------------------------------------------------  */
/*  Pagination (Web-like)  */

QWidget[pagination='true'] {
  background-color: transparent;
  padding: 8px 0;
}

QWidget[pagination='true'] QLabel {
  color: {{secondaryTextColor}};
}

QWidget[pagination='true'] QPushButton {
  color: {{primaryTextColor}};
  background-color: {{baseFillColor}};
  border: 1px solid {{baseBorderColor}};
  border-radius: 6px;
  padding: 4px 12px;
  min-height: 28px;
  margin-right: 8px;
  font-size: {{font_size}};
}

QWidget[pagination='true'] QPushButton:hover {
  background-color: {{darkFillColor}};
  border-color: {{primaryColor|opacity(0.5)}};
}

QWidget[pagination='true'] QPushButton:disabled {
  color: {{disabledTextColor}};
  background-color: {{baseFillColor|opacity(0.5)}};
  border-color: {{darkBorderColor|opacity(0.4)}};
}

QWidget[pagination='true'] QPushButton[primary='true'] {
  color: {{baseBackgroundColor}};
  background-color: {{primaryColor}};
  border-color: {{primaryColor}};
}

QWidget[pagination='true'] QPushButton[primary='true']:hover {
  background-color: {{primaryColor|opacity(0.85)}};
}

QWidget[pagination='true'] QPushButton#PrevPageBtn:disabled,
QWidget[pagination='true'] QPushButton#NextPageBtn:disabled {
  opacity: 0.8;
}

QWidget[pagination='true'] QPushButton[page='true'] {
  color: {{regularTextColor}};
  background-color: {{baseBackgroundColor}};
  border: 1px solid {{baseBorderColor}};
  border-radius: 6px;
  padding: 3px 10px;
  min-width: 32px;
  min-height: 28px;
}

QWidget[pagination='true'] QPushButton[page='true']:hover {
  background-color: {{lightFillColor}};
  border-color: {{primaryColor|opacity(0.5)}};
}

QWidget[pagination='true'] QPushButton[page='true'][active='true'] {
  color: {{baseBackgroundColor}};
  background-color: {{primaryColor}};
  border-color: {{primaryColor}};
}

/* 固定前面导航按钮尺寸，防止布局跳动 */
QWidget[pagination='true'] QPushButton#PrevPageBtn,
QWidget[pagination='true'] QPushButton#NextPageBtn {
  min-width: 72px;
}

QWidget[pagination='true'] QPushButton#FirstPageBtn,
QWidget[pagination='true'] PushButton#LastPageBtn {
  min-width: 72px;
  min-height: 28px;
  padding: 0 10px;
  font-weight: 600;
}

/* 页码滚动区固定高度，避免随内容抖动 */
QScrollArea#PageScroll {
  min-height: 36px;
}

/*  ------------------------------------------------------------------------  */
/*  QToolBox  */

QToolBox::tab {
  background-color: {{darkerFillColor}};
  color: {{secondaryTextColor}};
  text-transform: uppercase;
  border-radius: 2px;
}

QToolBox::tab:selected,
QToolBox::tab:hover {
  background-color: {{primaryColor|opacity(0.2)}};
}

/*  ------------------------------------------------------------------------  */
/*  QProgressBar  */

QProgressBar {
  border: 1px solid {{darkerBorderColor}};
  background-color: {{darkFillColor}};
  border-radius: 4px;
  text-align: center;
  color: {{primaryTextColor}};
}

QProgressBar::chunk {
  background-color: {{primaryColor}};
  border-radius: 3px;
}

QProgressBar[success='true']::chunk {
  background-color: {{success}};
}

QProgressBar[danger='true']::chunk {
  background-color: {{danger}};
}

QProgressBar[warning='true']::chunk {
  background-color: {{warning}};
}
/*  ------------------------------------------------------------------------  */
/*  QScrollBar  */

QScrollBar:horizontal {
  border-radius: 6px;
  background: {{baseFillColor}};
  height: 6px;
}

QScrollBar:vertical {
  border-radius: 6px;
  background: {{baseFillColor}};
  width: 6px;
}

QScrollBar::handle:horizontal {
  background: {{darkerBorderColor}};
  border-radius: 6px;
  min-width: 20px;
}

QScrollBar::handle:vertical {
  background: {{darkerBorderColor}};
  border-radius: 6px;
  min-height: 20px;
}

QScrollBar::handle:vertical:hover,
QScrollBar::handle:horizontal:hover {
  background: {{lightBorderColor}};
}

QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical,
QScrollBar::add-line:horizontal,
QScrollBar::sub-line:horizontal {
  border: 0;
  background: none;
}

/*  ------------------------------------------------------------------------  */
/*  QSlider  */

QSlider::groove:horizontal {
  height: 4px;
  background: {{darkFillColor}};
  border-radius: 2px;
}

QSlider::groove:vertical {
  width: 4px;
  background: {{darkFillColor}};;
  border-radius: 2px;
}

QSlider::handle:horizontal {
  image: url(icon:/primary/slider.svg);
  width: 16px;
  height: 16px;
  margin: -6px 0px;
}

QSlider::handle:vertical {
  image: url(icon:/primary/slider.svg);
  width: 16px;
  height: 16px;
  margin: 0px -6px;
}

QSlider::add-page {
  background: {{lightFillColor}};
}

QSlider::sub-page {
  background: {{primaryColor}};
  border-radius: 2px;
}

/*  ------------------------------------------------------------------------  */
/*  QToolBar  */

QToolBar {
  background-color: qlineargradient(x1:0 y1:0 x2:0 y2:1,
  stop:0 {{darkFillColor}},
  stop:1 {{baseBackgroundColor}});
  border-bottom: 1px solid {{darkerBorderColor}};
  spacing: 4px;
  padding: 4px;
}

QToolBar::handle:horizontal {
  image: url(icon:/primary/toolbar-handle-horizontal.svg);
}

QToolBar::handle:vertical {
  image: url(icon:/primary/toolbar-handle-vertical.svg);
}

QToolBar::separator:horizontal {
  margin: 4px 2px;
  background:{{darkerBorderColor}};
  width: 1px;
}

QToolBar::separator:vertical {
  margin: 4px 2px;
    background:{{darkerBorderColor}};
  height: 1px;
}

/*  ------------------------------------------------------------------------  */
/*  QToolButton  */

QToolButton {
  background: {{darkFillColor}};
  border: 0px;
  height: 40px;
  margin: 0px;
  padding: 0px;
  border-right: 0px solid {{darkBorderColor}};
  border-left: 0px solid {{darkBorderColor}};
}

QToolButton[menu='true'] {
  padding-right: 10px;
}

QToolButton::menu-indicator {
  subcontrol-origin: margin;
  subcontrol-position: bottom center;
  image: url(icon:/primary/downarrow.svg);
}

QToolButton:hover {
  background: {{lightFillColor}};
  border-right: 0px solid {{darkBorderColor}};
  border-left: 0px solid {{darkBorderColor}};
}

QToolButton:pressed {
  background: {{baseFillColor}};
  border-right: 0px solid {{darkBorderColor}};
  border-left: 0px solid {{darkBorderColor}};
}

QToolButton:checked {
  background: {{primaryColor}};
  border-left: 0px solid {{darkBorderColor}};
  border-right: 0px solid {{darkBorderColor}};
}

/*  ------------------------------------------------------------------------  */
/*  Items Selection */

QTableView:item,
QTreeView::item,
QListView::item {
  padding: 6px;
  border-bottom: 1px solid {{darkFillColor}};
}

QTableView:item:selected,
QTreeView::item:selected,
QListView::item:selected {
  background-color: {{darkFillColor|opacity(0.2)}};
  selection-background-color: {{darkerFillColor|opacity(0.2)}};
  color: {{regularTextColor}};
  selection-color: {{regularTextColor}}; /* For Windows */
}

QTableView:item:hover,
QTreeView::item:hover,
QListView::item:hover {
  background-color: {{primaryColor|opacity(0.2)}};
}

QTableView:item:selected:focus,
QTreeView::item:selected:focus,
QListView::item:selected:focus {
  background-color: {{primaryColor}};
  selection-background-color: {{primaryColor}};
  color: {{primaryTextColor}};
  selection-color: {{primaryTextColor}}; /* For Windows */
}

QTableView::item:disabled {
  color: {{disabledTextColor|opacity(0.3)}};
  selection-color: {{disabledTextColor|opacity(0.3)}};
  background-color: {{overlayBackgroundColor}};
  selection-background-color: {{overlayBackgroundColor}};
}

/*  ------------------------------------------------------------------------  */
/*  Custom buttons  */

QPushButton.danger {
  border-color: {{danger}};
  color: {{danger}};
}

QPushButton.danger:checked,
QPushButton.danger:pressed {
  color: {{primaryTextColor}};
  background-color: {{danger}};
}

QPushButton.warning{
  border-color: {{warning}};
  color: {{warning}};
}

QPushButton.warning:checked,
QPushButton.warning:pressed {
  color: {{primaryTextColor}};
  background-color: {{warning}};
}

QPushButton.success {
  border-color: {{success}};
  color: {{success}};
}

QPushButton.success:checked,
QPushButton.success:pressed {
  color: {{primaryTextColor}};
  background-color: {{success}};
}

QPushButton.danger:flat:hover {
  background-color: {{danger|opacity(0.2)}};
}

QPushButton.danger:flat:pressed,
QPushButton.danger:flat:checked {
  background-color: {{danger|opacity(0.1)}};
  color: {{danger}};
}

QPushButton.warning:flat:hover {
  background-color: {{warning|opacity(0.2)}};
}

QPushButton.warning:flat:pressed,
QPushButton.warning:flat:checked {
  background-color: {{warning|opacity(0.1)}};
  color: {{warning}};
}

QPushButton.success:flat:hover {
  background-color: {{success|opacity(0.2)}};
}

QPushButton.success:flat:pressed,
QPushButton.success:flat:checked {
  background-color: {{success|opacity(0.1)}};
  color: {{success}};
}

/*  ------------------------------------------------------------------------  */
/*  QLCDNumber  */

QLCDNumber {
  color: {{primaryColor}};
  background-color: {{primaryColor|opacity(0.1)}};
  border: 1px solid {{primaryColor|opacity(0.3)}};
  border-radius: 2px;
}

/*  ------------------------------------------------------------------------  */
/*  QCalendarWidget  */

#qt_calendar_navigationbar {
  background-color: {{lightFillColor}};
}

#qt_calendar_prevmonth,
#qt_calendar_nextmonth,
#qt_calendar_monthbutton,
#qt_calendar_yearbutton {
  border: none;
  color: {{regularTextColor}};
  background-color: transparent;
}

#qt_calendar_prevmonth {
  qproperty-icon: url(icon:/primary/leftarrow.svg);
}
#qt_calendar_nextmonth {
  qproperty-icon: url(icon:/primary/rightarrow.svg);
}

#qt_calendar_prevmonth:hover,
#qt_calendar_nextmonth:hover,
#qt_calendar_monthbutton:hover,
#qt_calendar_yearbutton:hover {
  color: {{primaryColor}};
  background-color: {{darkerFillColor}};
}

#qt_calendar_yearbutton {
  border: none;
  color: {{regularTextColor}};
  background-color: transparent;
}

QCalendarWidget QMenu::item {
  height: 26px;
  border: 0px solid transparent;
  color: {{regularTextColor}};
}

QCalendarWidget QMenu::item {
  padding: 0px 25px 0px 20px;
}

QCalendarWidget QMenu::item:selected {
  color: {{primaryTextColor}};
  background-color: {{primaryColor|opacity(0.3)}};
  border-radius: 2px;
}

QCalendarWidget QMenu::item:disabled {
  color: {{disabledTextColor|opacity(0.3)}};
}

QCalendarWidget QTableView {
  border: none;
  selection-background-color: {{lightFillColor}};
  selection-color: {{primaryColor}};
  color: {{primaryTextColor}};
  gridline-color: {{darkerFillColor}};
  border-radius: 2px;
  outline: 0;
}

QCalendarWidget QTableView:enabled::item {
  background-color: {{baseFillColor}};
}

/*  ------------------------------------------------------------------------  */
/*  Inline QLineEdit  */

QTreeView QLineEdit,
QTableView QLineEdit,
QListView QLineEdit {
  color: {{regularTextColor}};
  background-color: {{baseBorderColor}};
  selection-color: {{primaryTextColor}};
  selection-background-color: {{primaryColor}};
  border: 1px solid unset;
  border-radius: unset;
  padding: unset;
  padding-left: unset;
  height: unset;
  border-width: unset;
  border-top-left-radius: unset;
  border-top-right-radius: unset;
}

/*  ------------------------------------------------------------------------  */
/*  QToolTip  */

QToolTip {
  padding: 5px;
  border: 1px solid {{darkerBorderColor}};
  border-radius: 2px;
  color: {{primaryTextColor}};
  background-color: {{overlayBackgroundColor}};
  padding: 6px 10px;
  font-size: 11px;
}

/*  ------------------------------------------------------------------------  */
/*  QDialogButtonBox  */

QDialogButtonBox QPushButton {
  qproperty-icon: none;
}

/*  ------------------------------------------------------------------------  */
/*  Custom TitleBar Buttons  */

QToolButton#TitleBarMinButton,
QToolButton#TitleBarMaxButton,
QToolButton#TitleBarCloseButton {
  background: transparent;
  border: 0px;
  height: auto;
  margin: 0px;
  padding: 0px;
}

QToolButton#TitleBarMinButton:hover,
QToolButton#TitleBarMaxButton:hover {
  background-color: {{darkFillColor}};
}
QToolButton#TitleBarCloseButton:hover{
  background-color: {{danger}};
}

QToolButton#TitleBarMinButton:pressed,
QToolButton#TitleBarMaxButton:pressed {
  background-color: {{darkFillColor|opacity(0.4)}};
}
QToolButton#TitleBarCloseButton:pressed {
  background-color: {{danger|opacity(0.4)}};
}

/*  ------------------------------------------------------------------------  */
/*  Grips  */

QSizeGrip {
  image: url(icon:/primary/sizegrip.svg);
  background-color: transparent;
  width: 16px;
  height: 16px;
}

